{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check-staged-codepoints.py",
            "if": "Bash(git commit*)",
            "timeout": 20,
            "statusMessage": "Checking staged codepoints"
          }
        ]
      }
    ]
  }
}
