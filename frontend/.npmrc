# Node major is pinned in three places already (.nvmrc, package.json's
# engines field, and .github/workflows/ci.yml) after the 2026-07-18 CI
# incident, where dev on npm 11 and CI on npm 10 produced a lockfile the
# two majors could not agree on.
#
# What none of those pins did was *enforce* anything locally. On a machine
# running the wrong Node major, `npm ci` fails deep inside lockfile
# reconciliation with "Missing: esbuild@0.28.1 from lock file" -- which
# reads as a corrupt lockfile, sends you to regenerate it, and reintroduces
# the exact skew the pin exists to prevent. The engines mismatch is printed
# as a warning four lines above and is easy to scroll past.
#
# engine-strict turns that warning into the failure, so the error names the
# real cause: wrong Node version, not a broken lockfile.
engine-strict=true
